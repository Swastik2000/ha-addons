#!/bin/sh
# Scan CGI. op=info dumps the backend's capabilities so failures can be
# diagnosed without rebuilding the add-on.
q="$QUERY_STRING"
val() { echo "$q" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2- | sed 's/%20/ /g'; }

op=$(val op)

if [ "$op" = "info" ]; then
    echo "Content-Type: text/plain"; echo
    echo "### scanimage -L"; timeout 20 scanimage -L 2>&1 || echo "(timed out - device busy or wedged)"
    echo; echo "### scanimage -A (device options)"; timeout 25 scanimage -A 2>&1 || echo "(timed out - device busy or wedged)"
    echo; echo "### plugins"; ls -l /usr/share/hplip/scan/plugins/ 2>&1
    echo; echo "### hplip.state"; cat /var/lib/hp/hplip.state 2>&1
    echo; echo "### hplip.conf [hplip]"; grep -A2 '^\[hplip\]' /etc/hp/hplip.conf 2>&1
    echo; echo "### dll.conf"; grep -v '^#' /etc/sane.d/dll.conf 2>/dev/null | grep -v '^$'
    exit 0
fi

dpi=$(val dpi);    case "$dpi"  in 75|100|150|200|300|600) ;; *) dpi=300 ;; esac
mode=$(val mode);  case "$mode" in Gray|Color|Lineart) ;; *) mode=Gray ;; esac
fmt=$(val format); case "$fmt"  in jpeg|png) ;; *) fmt=jpeg ;; esac
# hpaio advertises a 381 mm scan height for this hardware but the glass is
# only A4. scanimage then asks for more scanlines than the scanner can
# deliver and SANE aborts with "Application transferred too few scanlines".
# Constrain the scan area explicitly.
size=$(val size)
case "$size" in
    letter) geom="-x 215.9 -y 279.4" ;;
    full)   geom="" ;;
    *)      geom="-x 215.9 -y 297" ;;   # A4, the default
esac
# Whitelisted: this value is word-split into scanimage's argv, so an
# unvalidated one lets any LAN client inject arbitrary scanimage options
# (--output-file would write anywhere the add-on can reach).
src=$(val source); case "$src" in Flatbed|ADF) ;; *) src="" ;; esac
extra="$geom"
[ -n "$src" ] && extra="$extra --source $src"

case "$dpi" in 600) SCAN_TIMEOUT=300 ;; 300) SCAN_TIMEOUT=180 ;; *) SCAN_TIMEOUT=120 ;; esac

tmp=$(mktemp /tmp/scan.XXXXXX)
err="$tmp.err"
# fires on normal exit and on SIGTERM when the browser disconnects mid-scan
trap 'rm -f "$tmp" "$err"' EXIT HUP INT TERM
# The scanner rejects a second client while busy, and the first attempt after
# a long idle can come back short. One retry costs nothing.
n=0
while [ $n -lt 2 ]; do
    # SIGTERM at $SCAN_TIMEOUT, SIGKILL 10s later: a wedged scanimage must
    # never keep hold of the scanner after the request is over.
    if timeout -k 10 "$SCAN_TIMEOUT" \
         scanimage --format="$fmt" --resolution "$dpi" --mode "$mode" $extra \
         > "$tmp" 2>"$err" && [ -s "$tmp" ]; then
        echo "Content-Type: image/$fmt"; echo "Cache-Control: no-store"; echo
        cat "$tmp"; exit 0
    fi
    n=$((n+1)); sleep 3
done
echo "Status: 500"; echo "Content-Type: text/plain"; echo
echo "scan failed (dpi=$dpi mode=$mode fmt=$fmt src=${src:-default}):"
cat "$err" 2>/dev/null
