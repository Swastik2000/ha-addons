#!/bin/sh
# Scan CGI.
#  - one scan at a time (a second request must never pile onto the device:
#    concurrent access leaves a stale usbfs claim that wedges the scanner)
#  - wake the scanner before the real scan; this hardware sleeps and the
#    first open after an idle period blocks
#  - every scanimage call is bounded, and SIGKILL is a last resort because
#    killing mid-transfer is what strands the usbfs claim
q="$QUERY_STRING"
val() { echo "$q" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2- | sed 's/%20/ /g'; }
op=$(val op)

if [ "$op" = "info" ]; then
    echo "Content-Type: text/plain"; echo
    echo "### scanimage -L"; timeout 25 scanimage -L 2>&1 || echo "(timed out)"
    echo; echo "### scanimage -A"; timeout 30 scanimage -A 2>&1 || echo "(timed out - device busy or asleep)"
    echo; echo "### lock"
    if [ -d /tmp/scan.lock ]; then
        # Age separates "a scan is genuinely running" from "a killed scan left
        # this behind"; without it an idle-looking device and a wedged one
        # produce identical output.
        echo "  HELD for $(( $(date +%s) - $(stat -c %Y /tmp/scan.lock) ))s (stale is >900s)"
    else
        echo "  (none - idle)"
    fi
    echo; echo "### plugins"; ls -l /usr/share/hplip/scan/plugins/ 2>&1
    echo; echo "### hplip.state"; cat /var/lib/hp/hplip.state 2>&1
    exit 0
fi

LOCK=/tmp/scan.lock
if ! mkdir "$LOCK" 2>/dev/null; then
    age=$(( $(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || echo 0) ))
    if [ "$age" -lt 900 ]; then
        echo "Status: 409"; echo "Content-Type: text/plain"; echo
        echo "A scan is already running (started ${age}s ago). Wait for it to finish."
        exit 0
    fi
    rmdir "$LOCK" 2>/dev/null; mkdir "$LOCK" 2>/dev/null   # stale lock
fi
trap 'rmdir "$LOCK" 2>/dev/null; rm -f "$tmp" "$err" "$tmp.pdf" 2>/dev/null' EXIT HUP INT TERM

dpi=$(val dpi);    case "$dpi"  in 75|100|150|200|300|600|1200) ;; *) dpi=300 ;; esac
mode=$(val mode);  case "$mode" in Gray|Color|Lineart) ;; *) mode=Gray ;; esac
fmt=$(val format); case "$fmt"  in jpeg|png|tiff|pdf) ;; *) fmt=jpeg ;; esac
if [ "$fmt" = "pdf" ]; then sfmt=tiff; else sfmt="$fmt"; fi
size=$(val size)
case "$size" in
    letter) geom="-x 215.9 -y 279.4" ;;
    full)   geom="" ;;
    *)      geom="-x 215.9 -y 297" ;;   # A4 - hpaio wrongly advertises 381 mm
esac
src=$(val source); case "$src" in Flatbed|ADF) ;; *) src="" ;; esac
extra="$geom"; [ -n "$src" ] && extra="$extra --source $src"
case "$dpi" in 1200) T=600 ;; 600) T=300 ;; 300) T=200 ;; *) T=150 ;; esac

tmp=$(mktemp /tmp/scan.XXXXXX); err="$tmp.err"

# Wake: this printer detaches from USB when idle and the first open blocks.
# A cheap enumerate costs ~1 s awake and gives the device time to come back.
timeout 30 scanimage -L >/dev/null 2>&1

# Retry the SCAN only. Format conversion is a separate, local step: if it
# fails the page is already captured, and re-scanning would spend another
# pass over the glass to reproduce bytes we are still holding.
n=1; scanned=0
while [ $n -le 3 ]; do
    if timeout -k 15 "$T" scanimage --format="$sfmt" --resolution "$dpi" \
         --mode "$mode" $extra > "$tmp" 2>"$err" && [ -s "$tmp" ]; then
        scanned=1; break
    fi
    # backoff must exceed the ~11 s USB re-enumeration, not the old 3 s
    n=$((n+1)); [ $n -le 3 ] && sleep 14
done

if [ "$scanned" != 1 ]; then
    echo "Status: 500"; echo "Content-Type: text/plain"; echo
    echo "scan failed after 3 attempts (dpi=$dpi mode=$mode fmt=$fmt size=${size:-a4}):"
    if [ -s "$err" ]; then cat "$err"; else
      echo "(no error output - scanimage was killed by the ${T}s timeout,"
      echo " which usually means the scanner never woke or is held by another client)"
    fi
    exit 0
fi

if [ "$fmt" = "pdf" ]; then
    if tiff2pdf -o "$tmp.pdf" "$tmp" 2>>"$err" && [ -s "$tmp.pdf" ]; then
        echo "Content-Type: application/pdf"; echo "Cache-Control: no-store"; echo
        cat "$tmp.pdf"; exit 0
    fi
    echo "Status: 500"; echo "Content-Type: text/plain"; echo
    echo "The page scanned correctly, but converting it to PDF failed."
    echo "Scan again with format=tiff to keep this page as an image."
    [ -s "$err" ] && cat "$err"
    exit 0
fi

echo "Content-Type: image/$fmt"; echo "Cache-Control: no-store"; echo
cat "$tmp"; exit 0
