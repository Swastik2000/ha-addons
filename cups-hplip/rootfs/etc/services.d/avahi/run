#!/usr/bin/with-contenv bashio
# Read /data/options.json directly: bashio::config goes through the
# Supervisor API, which makes the add-on untestable outside Home Assistant.
for _ in $(seq 1 30); do [ -S /run/dbus/system_bus_socket ] && break; sleep 1; done
bashio::log.info "Starting avahi-daemon for AirPrint discovery"
exec avahi-daemon --no-chroot --no-rlimits -f /etc/avahi/avahi-daemon.conf
