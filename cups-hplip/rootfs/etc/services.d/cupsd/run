#!/usr/bin/with-contenv bash
echo "[cupsd] binary: $(command -v cupsd || echo 'NOT FOUND')"
mkdir -p /run/cups /var/log/cups /share/cups/logs
echo "[cupsd] --- config test ---"
/usr/sbin/cupsd -t 2>&1 | sed 's/^/[cupsd-t] /'
echo "[cupsd] --- starting ---"
/usr/sbin/cupsd -f 2>&1
rc=$?
echo "[cupsd] EXITED with rc=$rc"
[ -s /share/cups/logs/error_log ] && tail -5 /share/cups/logs/error_log | sed 's/^/[cupsd-log] /'
sleep 5
exit $rc
